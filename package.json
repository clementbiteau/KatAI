{
  "name": "katai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:e2e": "KATAI_E2E=1 NEXT_PUBLIC_FIREBASE_USE_EMULATORS=1 next build",
    "start:e2e": "KATAI_E2E=1 KATAI_FAKE_PROVIDER=1 NEXT_PUBLIC_FIREBASE_USE_EMULATORS=1 METADATA_SERVER_DETECTION=none KEY_ENCRYPTION_KEY=$(openssl rand -base64 32) next start --port 3100",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-katai \"vitest run --project emulator\"",
    "check:structure": "node scripts/check-structure.ts",
    "smoke:provider": "node --conditions=react-server scripts/smoke-provider.ts",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
