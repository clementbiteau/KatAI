# Copy to .env.local for local development. Never commit real values.
# In production, set these in the Vercel project settings (server values as sensitive).

# Firebase web app configuration (public identifiers, safe in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Base64-encoded service account JSON for the Firebase Admin SDK.
FIREBASE_SERVICE_ACCOUNT=

# Server only. 32 random bytes, base64-encoded, used to encrypt users' provider keys
# (docs/adr/0004-chiffrement-des-cles.md). Generate with: openssl rand -base64 32
KEY_ENCRYPTION_KEY=
# Previous master key, only while rotating.
KEY_ENCRYPTION_KEY_PREVIOUS=

# Do NOT define ANTHROPIC_API_KEY or OPENAI_API_KEY anywhere: KatAI only ever uses
# the key each user saves (docs/adr/0005-appels-aux-fournisseurs.md).
